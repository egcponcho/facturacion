# Variables de entorno de la instalación. Copie este archivo como .env (o
# defínalas en la plataforma de la nube) y complete las marcadas OBLIGATORIA.
# Todo lo del negocio (reglas, roles, catálogos, idioma, moneda…) NO va aquí:
# se configura dentro de la aplicación y se guarda en la base de datos.
# Guía completa: docs/PRODUCCION.md

# ---- Base de datos (OBLIGATORIA en producción) --------------------------------
# PostgreSQL. Se aceptan postgres://, postgresql:// y postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://usuario:clave@servidor:5432/facturas

# ---- Seguridad -----------------------------------------------------------------
# OBLIGATORIA: clave al azar de 32 caracteres o más. Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si se cambia, todas las sesiones se cierran.
SECRET_KEY=
# La cookie de sesión solo viaja por https (dejar en 1 en producción)
COOKIE_SEGURA=1
# Dominio(s) desde donde se abre la aplicación, separados por coma. Si el
# frontend se sirve desde el mismo servidor (Dockerfile), basta con su URL.
CORS_ORIGINS=https://facturacion.miempresa.com
# Duración de la sesión y cierre por inactividad
SESION_HORAS=12
SESION_INACTIVIDAD_MIN=30
# Bloqueo tras intentos fallidos de contraseña
INTENTOS_MAX=5
BLOQUEO_MIN=15

# ---- Verificación en dos pasos por SMS ----------------------------------------
DOS_PASOS=1
# twilio: envía el SMS. consola: el código solo queda en el registro del servidor.
SMS_PROVEEDOR=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CODIGO_VALIDEZ_MIN=5
CODIGO_REENVIO_SEG=30

# ---- Instalación nueva ---------------------------------------------------------
# Solo se usan si la base no tiene usuarios. La contraseña es temporal: el
# sistema pide cambiarla al primer ingreso. Bórrelas después del primer arranque.
EMPRESA_NOMBRE=Mi Empresa, S.A.
ADMIN_EMAIL=admin@miempresa.com
ADMIN_PASSWORD=
# Celular del administrador (formato +50370000000), necesario con DOS_PASOS=1
ADMIN_TELEFONO=

# ---- Archivos ------------------------------------------------------------------
# Carpeta de adjuntos (facturas, fichas, fotos). Debe ser un disco persistente
# con respaldo.
UPLOAD_DIR=/data/archivos
# Tamaño máximo de un archivo que se sube (MB)
MAX_SUBIDA_MB=25

# ---- Opcional ------------------------------------------------------------------
# Opinión del especialista con Claude en la clasificación arancelaria. Sin
# clave, la opción no aparece.
ANTHROPIC_API_KEY=

# ---- Solo demostración ---------------------------------------------------------
# 1: carga datos de ejemplo en una base vacía (empresa, proveedores, órdenes…).
# NUNCA en producción.
SEED_DEMO=0
